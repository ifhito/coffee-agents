OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
OLLAMA_BASE_URL=http://localhost:11434/api  # optional
OLLAMA_MODEL=qwen3:8b                        # optional

# --- OCR取込ワークフロー用 ---
SUPABASE_SERVICE_ROLE_KEY=   # INSERT用サービスロールキー (RLS回避)。SUPABASE_URLと同一プロジェクトのキーを使うこと
OCR_MODEL=qwen2.5vl:7b       # Ollamaモデル名 (デフォルト: qwen2.5vl:7b)
OCR_PROVIDER=ollama          # "ollama" or "openai"

# --- Timeout設定 (ms) ---
COFFEE_CHAT_TIMEOUT_MS=120000
OCR_INGEST_TIMEOUT_MS=120000
OCR_EXTRACT_TIMEOUT_MS=120000
OCR_CONFIRM_TIMEOUT_MS=45000
MASTRA_SERVER_TIMEOUT_MS=300000
